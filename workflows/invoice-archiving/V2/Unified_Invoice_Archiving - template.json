      "id": "baab2d06-9525-412c-add0-e53d9f80052c",
      "name": "Gmail - Get invoice messages",
      "type": "n8n-nodes-base.gmail",
      "position": [
        304,
        272
      ],
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "93c6857c-ec25-4eee-86e1-46c9afedde10",
              "operator": {
                "type": "array",
                "operation": "lengthGt",
                "rightType": "number"
              },
              "leftValue": "={{ Object.keys($binary ?? {}) }}",
              "rightValue": 0
            }
          ]
        },
        "options": {}
