{"active":false,"connections":{"Attach AbuseIPDB Enrichment":{"main":[[{"index":0,"node":"Compute Incident Risk Score","type":"main"}]]},"Build Daily Security Digest":{"main":[[{"index":0,"node":"Send Daily Security Digest","type":"main"}]]},"Bypass Threat Intelligence Step":{"main":[[{"index":0,"node":"Compute Incident Risk Score","type":"main"}]]},"Cache Alert for IP Check":{"main":[[{"index":0,"node":"Fetch AbuseIPDB IP Reputation","type":"main"}]]},"Compute Incident Risk Score":{"main":[[{"index":0,"node":"Store Enriched Incident","type":"main"},{"index":0,"node":"If Severity Is Critical or High","type":"main"}]]},"Daily 6 PM Schedule Trigger":{"main":[[{"index":0,"node":"Fetch Incidents from Last 24 Hours","type":"main"}]]},"Evaluate Deduplication Time Window":{"main":[[{"index":0,"node":"If Incident Is Duplicate","type":"main"}]]},"Fetch AbuseIPDB IP Reputation":{"main":[[{"index":0,"node":"Attach AbuseIPDB Enrichment","type":"main"}]]},"Fetch Incidents from Last 24 Hours":{"main":[[{"index":0,"node":"Build Daily Security Digest","type":"main"}]]},"Filter Valid Security Alerts":{"main":[[{"index":0,"node":"Generate Alert Fingerprint","type":"main"}]]},"Generate Alert Fingerprint":{"main":[[{"index":0,"node":"Get Latest Matching Incident","type":"main"}]]},"Get Latest Matching Incident":{"main":[[{"index":0,"node":"Evaluate Deduplication Time Window","type":"main"}]]},"If IPv4 Is Public":{"main":[[{"index":0,"node":"Cache Alert for IP Check","type":"main"}],[{"index":0,"node":"Bypass Threat Intelligence Step","type":"main"}]]},"If Incident Is Duplicate":{"main":[[{"index":0,"node":"Prepare Suppressed Duplicate Record","type":"main"}],[{"index":0,"node":"If IPv4 Is Public","type":"main"}]]},"If Severity Is Critical or High":{"main":[[{"index":0,"node":"Send High Priority Email Alert","type":"main"},{"index":0,"node":"Send Critical Telegram Message","type":"main"}],[{"index":0,"node":"If Severity Is Medium","type":"main"}]]},"If Severity Is Medium":{"main":[[{"index":0,"node":"Send Medium Severity Email","type":"main"}],[{"index":0,"node":"Mark Low Severity as Stored Only","type":"main"}]]},"Normalize Splunk Alert Payload":{"main":[[{"index":0,"node":"Filter Valid Security Alerts","type":"main"}]]},"Prepare Suppressed Duplicate Record":{"main":[[{"index":0,"node":"Store Suppressed Incident Record","type":"main"}]]},"When Manually Started":{"main":[[{"index":0,"node":"Initialize Incident Data Table","type":"main"}]]},"When Splunk Alert Arrives":{"main":[[{"index":0,"node":"Normalize Splunk Alert Payload","type":"main"}]]}},"id":"lAEfC0lpJJxnRBSq","meta":{"instanceId":"9d797abf871ff7776b72030f386aac63fbb09752ce3bb94854a66e7091951bfc"},"name":"Splunk Security Alert Enrichment, Deduplication & Smart Notifications","nodeGroups":[],"nodes":[{"id":"6c091fcf-007d-40f1-9991-b49de128f7c8","name":"Sticky Note","parameters":{"content":"## Splunk Security Alert Enrichment, Deduplication & Smart Notifications\n\n### How it works\n\n1. Receives Splunk alerts via webhook, then normalizes and validates each payload.\n2. Fingerprints alerts and looks up recent incidents to detect duplicates within a time window.\n3. Branches on public IPv4s to enrich with AbuseIPDB or bypass enrichment when not applicable.\n4. Calculates a risk score, stores enriched or suppressed incidents, and routes notifications by severity (email/Telegram).\n5. Generates and emails a daily 24-hour security digest from stored incidents.\n\n### Setup steps\n\n- - [ ] Configure the Webhook URL in Splunk to point to the \"When Splunk Alert Received\" node’s endpoint.\n- - [ ] Set up Data Table resources/collections for incidents and suppressed incidents referenced by dataTable nodes.\n- - [ ] Add the AbuseIPDB API key to HTTP Request headers (e.g., Key: X-Api-Key) in \"Get AbuseIPDB IP Reputation\".\n- - [ ] Provide SMTP/email credentials for all Email nodes and set sender/recipients.\n- - [ ] Configure Telegram Bot API credentials and target chat/channel for the Telegram node.\n- - [ ] Define the deduplication window and fingerprint fields in the relevant Code nodes (environment variables or node params).\n- - [ ] Review and set severity thresholds used by \"Calculate Incident Risk Score\" and branching If nodes.\n- - [ ] Adjust the schedule in \"Every Day at 6 PM\" to your preferred time zone and delivery time.\n- - [ ] Use the \"Manual Setup Trigger\" once to initialize or create the incident table schema if required by your Data Table implementation.\n\n### Customization\n\n- Tune risk scoring weights and severity thresholds in the scoring code.\n- Modify fingerprint composition to better reflect your environment and alert types.\n- Customize email/Telegram templates and recipients per severity.\n- Extend enrichment to additional threat intel sources alongside AbuseIPDB.\n- Change the daily digest timeframe or include per-source sections.","height":1088,"width":480},"position":[0,0],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"addb2d95-94a8-4829-810a-c238d9575fed","name":"Sticky Note1","parameters":{"color":7,"content":"## Manual setup and table\n\nTop-left setup cluster to manually initialize and create the incident data table.","height":304,"width":464},"position":[560,0],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"a64d58cc-c9a2-476c-8a39-518f23abee4a","name":"Sticky Note2","parameters":{"color":7,"content":"## Receive and normalize alerts\n\nWebhook intake for Splunk alerts and initial normalization, located on the left mid-row.","height":304,"width":464},"position":[560,448],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"35e48e03-a0ff-4cc6-a8c0-daa9438c7695","name":"Sticky Note3","parameters":{"color":7,"content":"## Filter and fingerprint alerts\n\nValidates normalized alerts and builds a deterministic fingerprint; adjacent mid-row cluster.","height":304,"width":448},"position":[1088,448],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"6f14ab66-3667-4cc2-a12f-642bdf47fbd1","name":"Sticky Note4","parameters":{"color":7,"content":"## Match incidents and dedupe\n\nFetches latest matching incident, evaluates dedup window, then branches on duplicate status.","height":304,"width":720},"position":[1600,448],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"2a92b8d1-b3f4-4cfd-b578-a3d48044026a","name":"Sticky Note5","parameters":{"color":7,"content":"## Prepare and store duplicates\n\nLower-right of the dedupe fork: formats suppressed duplicate incidents and stores them.","height":304,"width":448},"position":[2384,608],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"811eff01-0df4-4da1-b133-19161fd5380e","name":"Sticky Note6","parameters":{"color":7,"content":"## Public IP branch and bypass\n\nUpper-right branch from dedupe: decides on public IPv4 and supports a bypass path to scoring.","height":448,"width":448},"position":[2384,128],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"fe7b0b01-507f-400e-bff4-23491b6e78c6","name":"Sticky Note7","parameters":{"color":7,"content":"## AbuseIPDB enrichment path\n\nCompact top-right cluster that caches the alert, queries AbuseIPDB, and attaches intel.","height":304,"width":608},"position":[2896,32],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"481ee70b-1dcc-4de2-8f4f-b71989a7f75e","name":"Sticky Note8","parameters":{"color":7,"content":"## Risk scoring and storage\n\nCentral-right cluster calculating incident risk and persisting enriched incident records.","height":304,"width":448},"position":[3680,336],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"53380061-829c-4a28-97bf-405256d9a329","name":"Sticky Note9","parameters":{"color":7,"content":"## Critical/high severity notifications\n\nSeverity gate and high-priority notifications: email and Telegram for critical/high incidents.","height":464,"width":464},"position":[4192,192],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"d86d4387-d867-45b7-87aa-a9721db26be2","name":"Sticky Note10","parameters":{"color":7,"content":"## Medium and low handling\n\nMedium branch sends email; low severity is marked as stored-only; tight lower-right cluster.","height":464,"width":448},"position":[4464,688],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"7301a544-30d3-44ea-b624-484173d010c5","name":"Sticky Note11","parameters":{"color":7,"content":"## Daily digest generation\n\nBottom row schedule that fetches last 24h incidents, builds, and emails a daily digest.","height":272,"width":976},"position":[560,1504],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"b6159285-17a2-4152-bd6f-dfa39607b0c2","name":"When Manually Started","parameters":{},"position":[608,128],"type":"n8n-nodes-base.manualTrigger","typeVersion":1},{"id":"2769c949-491c-47fe-962f-8c6ac27630d5","name":"Initialize Incident Data Table","parameters":{"columns":{"column":[{"name":"received_at"},{"name":"received_epoch","type":"number"},{"name":"fingerprint"},{"name":"is_duplicate","type":"boolean"},{"name":"search_name"},{"name":"src_ip"},{"name":"splunk_severity"},{"name":"risk_score","type":"number"},{"name":"risk_level"},{"name":"failed_attempts","type":"number"},{"name":"targeted_users"},{"name":"targeted_hosts"},{"name":"abuse_score","type":"number"},{"name":"country_code"},{"name":"isp"},{"name":"total_reports","type":"number"},{"name":"results_link"}]},"operation":"create","options":{"createIfNotExists":true},"resource":"table","tableName":"Splunk Security Incidents"},"position":[880,128],"type":"n8n-nodes-base.dataTable","typeVersion":1.1},{"id":"d0f26423-6597-463a-b50c-293d1cd1d024","name":"When Splunk Alert Arrives","parameters":{"httpMethod":"POST","options":{},"path":"splunk-security-alert"},"position":[608,576],"type":"n8n-nodes-base.webhook","typeVersion":2.1,"webhookId":"59750d7e-398d-471d-9170-92191472e00d"},{"id":"3c67c7eb-2d1d-49d9-b4a2-200806b8bea1","name":"Normalize Splunk Alert Payload","parameters":{"jsCode":"const x=$input.item.json??{},b=x.body??x,r=b.result??{};const f=(...v)=>v.find(z=>z!==undefined&&z!==null&&String(z).trim()!=='')??'';const mv=v=>Array.isArray(v)?v.map(String):v?String(v).split(/[\n,]+/).map(s=>s.trim()).filter(Boolean):[];const u=mv(f(r.targeted_users,r.user,r.users,r.target_user)),h=mv(f(r.targeted_hosts,r.host,r.hosts,r.dest_host));const a=parseInt(f(r.failed_attempts,r.count,r.event_count,0),10)||0;let s=String(f(b.severity,b.urgency,r.severity,r.urgency)).toLowerCase();s=({crit:'critical',severe:'critical',warning:'medium',info:'informational'})[s]??s;if(!['critical','high','medium','low','informational'].includes(s))s=a>=20?'critical':a>=10?'high':a>=3?'medium':'low';const ip=String(f(r.src_ip,r.source_ip,r.src,r.rhost)).trim();const p=ip.split('.').map(Number);const pub=p.length===4&&!p.some(n=>!Number.isInteger(n)||n<0||n>255)&&p[0]!==10&&p[0]!==127&&p[0]!==0&&p[0]<224&&!(p[0]===169&&p[1]===254)&&!(p[0]===172&&p[1]>=16&&p[1]<=31)&&!(p[0]===192&&p[1]===168)&&!(p[0]===100&&p[1]>=64&&p[1]<=127);const now=new Date();return{json:{search_name:String(f(b.search_name,r.search_name,b.name,'Splunk alert')),results_link:String(f(b.results_link,r.results_link)),splunk_severity:s,src_ip:ip,is_public_ipv4:pub,failed_attempts:a,targeted_users:u,targeted_users_str:u.join(', ')||'N/A',targeted_hosts:h,targeted_hosts_str:h.join(', ')||'N/A',unique_users:parseInt(r.unique_users,10)||u.length,unique_hosts:parseInt(r.unique_hosts,10)||h.length,received_at:now.toISOString(),received_epoch:now.getTime()}};","mode":"runOnceForEachItem"},"position":[880,576],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"193b2b14-80d3-4295-be4d-b05c8ba1e62c","name":"Filter Valid Security Alerts","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"be4bcab5-2a56-4dc0-9f70-6ad69195db76","leftValue":"=","operator":{"operation":"notEmpty","singleValue":true,"type":"string"},"rightValue":""}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1}},"options":{}},"position":[1136,576],"type":"n8n-nodes-base.filter","typeVersion":2.2},{"id":"15f288bb-90ee-4bbc-99d9-7a431fcbe8d5","name":"Generate Alert Fingerprint","parameters":{"jsCode":"const i=$json;\nconst canonical=[\n  i.search_name||'',\n  i.src_ip||'',\n  ...(i.targeted_users||[]).sort(),\n  ...(i.targeted_hosts||[]).sort()\n].join('|').toLowerCase();\n\nlet h=2166136261;\nfor(let x=0;x<canonical.length;x++){\n  h^=canonical.charCodeAt(x);\n  h=Math.imul(h,16777619);\n}\nconst fingerprint=(h>>>0).toString(16).padStart(8,'0');\n\nconst current_alert={...i,fingerprint};\nconst state=$getWorkflowStaticData('global');\nstate._splunkPending=state._splunkPending||{};\nstate._splunkPending[fingerprint]=current_alert;\nreturn {json:{...current_alert,_current_alert_json:JSON.stringify(current_alert)}};","mode":"runOnceForEachItem"},"position":[1392,576],"type":"n8n-nodes-base.code","typeVersion":2},{"alwaysOutputData":true,"id":"b68ac7a3-91fb-471e-9487-675887bcac95","name":"Get Latest Matching Incident","parameters":{"dataTableId":{"__rl":true,"mode":"name","value":"Splunk Security Incidents"},"filters":{"conditions":[{"keyName":"fingerprint","keyValue":"="}]},"matchType":"allConditions","operation":"get","orderBy":true,"orderByColumn":"received_epoch","returnAll":"=false"},"position":[1648,576],"type":"n8n-nodes-base.dataTable","typeVersion":1.1},{"id":"32b071fa-39b5-4282-94a7-541cefb07f64","name":"Evaluate Deduplication Time Window","parameters":{"jsCode":"const previous=$json||{};\nconst state=$getWorkflowStaticData('global');\nconst pending=state._splunkPending||{};\nconst fingerprint=String(previous.fingerprint||'');\n\n// A Data Table match contains fingerprint. If no row was found, recover the only\n// pending alert for this execution. This keeps the workflow independent of node names.\nlet current = fingerprint ? pending[fingerprint] : null;\nif (!current) {\n  const keys=Object.keys(pending);\n  current=keys.length ? pending[keys[keys.length-1]] : {};\n}\n\nconst previousEpoch=Number(previous.received_epoch||0);\nconst cooldownMinutes=15;\nconst isDuplicate=previousEpoch>0 &&\n  (Number(current.received_epoch||Date.now())-previousEpoch)<cooldownMinutes*60*1000;\n\nif (current.fingerprint) delete pending[current.fingerprint];\n\nreturn {\n  json:{\n    ...current,\n    is_duplicate:isDuplicate,\n    previous_received_at:previous.received_at||'',\n    dedup_cooldown_minutes:cooldownMinutes\n  }\n};","mode":"runOnceForEachItem"},"position":[1920,576],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"5c7d9dee-c13c-466c-ac0e-ea90d6e58af4","name":"If Incident Is Duplicate","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"793bd80a-09b2-46b6-9faa-64ca76e06b96","leftValue":"=","operator":{"operation":"equals","type":"boolean"},"rightValue":true}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2}},"options":{}},"position":[2176,576],"type":"n8n-nodes-base.if","typeVersion":2.2},{"id":"8fd3e3cd-d610-4eb8-adf6-a7e7a48f5a52","name":"Prepare Suppressed Duplicate Record","parameters":{"jsCode":"return{json:{...$json,risk_score:0,risk_level:'suppressed',threat_intel:{abuse_confidence_score:0,country_code:'N/A',isp:'N/A',total_reports:0}}};","mode":"runOnceForEachItem"},"position":[2432,736],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"a735e60b-0170-4057-845d-5af24abef42c","name":"If IPv4 Is Public","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"fa6116a1-941e-4630-92d5-f84c5496fd00","leftValue":"=","operator":{"operation":"equals","type":"boolean"},"rightValue":true}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2}},"options":{}},"position":[2432,256],"type":"n8n-nodes-base.if","typeVersion":2.2},{"id":"9d6ff968-705c-4f5c-a5ce-fed00599fca2","name":"Fetch AbuseIPDB IP Reputation","parameters":{"headerParameters":{"parameters":[{"name":"Key","value":"YOUR_ABUSEIPDB_API_KEY"},{"name":"Accept","value":"application/json"}]},"options":{"response":{"response":{"neverError":true}}},"queryParameters":{"parameters":[{"name":"ipAddress","value":"="},{"name":"maxAgeInDays","value":"90"},{"name":"verbose","value":"true"}]},"sendHeaders":true,"sendQuery":true,"url":"https://api.abuseipdb.com/api/v2/check"},"position":[3136,160],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"855c5f60-6b2f-4b19-9124-16f6189c5d62","name":"Attach AbuseIPDB Enrichment","parameters":{"jsCode":"const response=$json??{};\nconst d=response.data??{};\nconst state=$getWorkflowStaticData('global');\nconst cache=state._splunkEnrichment||{};\n\n// AbuseIPDB returns the checked IP as data.ipAddress.\nconst key=String(d.ipAddress||'__no_ip__');\nconst base=cache[key]||{};\nif (cache[key]) delete cache[key];\n\nreturn {json:{\n  ...base,\n  threat_intel:{\n    abuse_confidence_score:Number(d.abuseConfidenceScore||0),\n    country_code:d.countryCode||'N/A',\n    isp:d.isp||'N/A',\n    total_reports:Number(d.totalReports||0)\n  }\n}};","mode":"runOnceForEachItem"},"position":[3344,160],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"69c02874-faff-4a7f-a4d0-221a4f2316f6","name":"Bypass Threat Intelligence Step","parameters":{"jsCode":"return{json:{...$json,threat_intel:{abuse_confidence_score:0,country_code:'N/A',isp:'N/A',total_reports:0}}};","mode":"runOnceForEachItem"},"position":[2688,400],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"5f7b56b1-afd2-4493-8357-ac93d44cf3bb","name":"Compute Incident Risk Score","parameters":{"jsCode":"const i=$json;let s=({critical:50,high:35,medium:20,low:5,informational:0})[i.splunk_severity]??0,a=+i.failed_attempts||0;s+=a>=50?25:a>=20?15:a>=10?10:a>=3?5:0;const ab=+i.threat_intel.abuse_confidence_score||0;s+=ab>=90?30:ab>=70?20:ab>=40?10:0;const u=+i.unique_users||0,h=+i.unique_hosts||0;s+=u>=10?15:u>=5?10:0;s+=h>=5?15:h>=2?5:0;s=Math.min(100,s);const l=s>=75?'critical':s>=50?'high':s>=30?'medium':'low',m={critical:['CRITICAL','🔴','#b91c1c'],high:['HIGH','🟠','#c2410c'],medium:['MEDIUM','🟡','#a16207'],low:['LOW','🟢','#4d7c0f']}[l];return{json:{...i,risk_score:s,risk_level:l,risk_label:m[0],risk_emoji:m[1],risk_color:m[2]}};","mode":"runOnceForEachItem"},"position":[3728,464],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"18047973-9e03-4634-8f52-096cb0936307","name":"Store Suppressed Incident Record","parameters":{"columns":{"attemptToConvertTypes":true,"convertFieldsToString":false,"mappingMode":"defineBelow","matchingColumns":[],"schema":[{"defaultMatch":false,"display":true,"displayName":"received_at","id":"received_at","readOnly":false,"removed":false,"required":false,"type":"string"},{"defaultMatch":false,"display":true,"displayName":"received_epoch","id":"received_epoch","readOnly":false,"removed":false,"required":false,"type":"number"},{"defaultMatch":false,"display":true,"displayName":"fingerprint","id":"fingerprint","readOnly":false,"removed":false,"required":false,"type":"string"},{"defaultMatch":false,"display":true,"displayName":"is_duplicate","id":"is_duplicate","readOnly":false,"removed":false,"required":false,"type":"boolean"},{"defaultMatch":false,"display":true,"displayName":"search_name","id":"search_name","readOnly":false,"removed":false,"required":false,"type":"string"},{"defaultMatch":false,"display":true,"displayName":"src_ip","id":"src_ip","readOnly":false,"removed":false,"required":false,"type":"string"},{"defaultMatch":false,"display":true,"displayName":"splunk_severity","id":"splunk_severity","readOnly":false,"removed":false,"required":false,"type":"string"},{"defaultMatch":false,"display":true,"displayName":"risk_score","id":"risk_score","readOnly":false,"removed":false,"required":false,"type":"number"},{"defaultMatch":false,"display":true,"displayName":"risk_level","id":"risk_level","readOnly":false,"removed":false,"required":false,"type":"string"},{"defaultMatch":false,"display":true,"displayName":"failed_attempts","id":"failed_attempts","readOnly":false,"removed":false,"required":false,"type":"number"},{"defaultMatch":false,"