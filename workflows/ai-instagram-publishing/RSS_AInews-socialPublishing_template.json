    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "Your new Instagram post is here!",
        "message": "={{ $json.output }}",
        "options": {}
      },
      "id": "0befba7d-e9f9-4e91-908e-ed778f9d2289",
      "name": "Send Content Confirmation1",
      "type": "n8n-nodes-base.gmail",
