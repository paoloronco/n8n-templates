    {
      "parameters": {
        "jsCode": "const out=[];for(let i=0;i<items.length;i++){const it=items[i];for(const [key,b] of Object.entries(it.binary||{})){const name=String(b.fileName||'');if(!name.toLowerCase().endsWith('.pdf')&&String(b.mimeType||'').toLowerCase()!=='application/pdf')continue;out.push({json:{...it.json,attachmentKey:key},binary:{data:{...b,fileName:name||'invoice.pdf'}},pairedItem:{item:i}});}}return out;"
      },
      "id": "f75593c0-aead-4d45-85a7-5a6a585a7bc0",
      "name": "Normalize PDF binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        192
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "9387c62c-f4e4-4729-a722-ebf81f325e19",
      "name": "Extract PDF text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        3080,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source=$('Configure Providers').item;\nif(!source?.binary?.data)throw new Error('Missing paired PDF');\nconst b=source.binary.data;\nconst text=String(item.json.text||item.json.data||item.json.output||'').replace(/\\r/g,'');\nif(text.trim().length<30)throw new Error('Empty or scanned PDF; OCR required');\nconst from=String(source.json.from?.text||source.json.from||source.json.sender||'').toLowerCase();\nconst profile=(source.json.providerProfiles||[]).find(p=>p.senderContains&&from.includes(p.senderContains.toLowerCase()));\nif(!profile)throw new Error('No configured provider matches the sender');\nfunction cap(pattern){const m=text.match(new RegExp(pattern,'i'));return m?String(m[1]||'').trim():'';}\nfunction money(v){if(!v)return null;let s=v.replace(/[^0-9,.-]/g,'');const c=s.lastIndexOf(','),d=s.lastIndexOf('.');if(c>=0&&d>=0)s=c>d?s.replace(/\\./g,'').replace(',','.'):s.replace(/,/g,'');else if(c>=0)s=s.replace(',','.');const n=Number(s);return Number.isFinite(n)?Math.round(n*100)/100:null;}\nfunction iso(s){const m=s.match(/^(\\d{1,2})[./-](\\d{1,2})[./-](20\\d{2})$/);if(!m)return '';const d=+m[1],mo=+m[2],y=+m[3],dt=new Date(Date.UTC(y,mo-1,d));return dt.getUTCDate()===d&&dt.getUTCMonth()===mo-1?`${y}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}`:'';}\nconst invoiceNumber=cap(profile.invoicePattern),date=iso(cap(profile.datePattern)),amount=money(cap(profile.amountPattern)),service=cap(profile.servicePattern);\nif(!invoiceNumber||!date||amount===null)throw new Error(`Invalid invoice: ${profile.id}; adjust provider regex patterns`);\nif(!profile.folder||profile.folder.includes('YOUR_SFTP_ROOT'))throw new Error('Configure a real SFTP destination folder');\nconst fileName=`${date.replace(/-/g,'')} ${profile.id} ${invoiceNumber.replace(/[^A-Za-z0-9._-]/g,'-')}.pdf`;\nreturn {json:{provider:profile.id,providerName:profile.name,invoiceNumber,date,amount,service,currency:profile.currency||'EUR',uniqueKey:`${profile.id}:${invoiceNumber}`,fileName,targetPath:`${profile.folder.replace(/\\/$/,'')}/${fileName}`,sourceMessageId:source.json.id||source.json.messageId||''},binary:{data:{...b,fileName}}};"
      },
