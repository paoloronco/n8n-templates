        "jsCode": "const entities = { '&amp;': '&', '&lt;': '<', '&gt;': '>', '&quot;': '\"', '&#39;': \"'\", '&nbsp;': ' ' };\nconst rawHtml = $json.content?.rendered ?? '';\nconst text = rawHtml\n  .replace(/<(script|style)[^>]*>[\\s\\S]*?<\\/\\1>/gi, ' ')\n  .replace(/<br\\s*\\/?>/gi, '. ')\n  .replace(/<\\/(p|li|h[1-6])>/gi, '. ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&#(\\d+);/g, (_, code) => String.fromCodePoint(Number(code)))\n  .replace(/&[a-zA-Z#0-9]+;/g, match => entities[match] ?? match)\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nif (!text) throw new Error('The WordPress post has no readable text');\nreturn { text };"
