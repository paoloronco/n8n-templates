      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const i=$json;\nconst canonical=[\n  i.search_name||'',\n  i.src_ip||'',\n  ...(i.targeted_users||[]).sort(),\n  ...(i.targeted_hosts||[]).sort()\n].join('|').toLowerCase();\n\nlet h=2166136261;\nfor(let x=0;x<canonical.length;x++){\n  h^=canonical.charCodeAt(x);\n  h=Math.imul(h,16777619);\n}\nconst fingerprint=(h>>>0).toString(16).padStart(8,'0');\n\nconst current_alert={...i,fingerprint};\nconst state=$getWorkflowStaticData('global');\nstate._splunkPending=state._splunkPending||{};\nstate._splunkPending[fingerprint]=current_alert;\nreturn {json:{...current_alert,_current_alert_json:JSON.stringify(current_alert)}};"
      },
