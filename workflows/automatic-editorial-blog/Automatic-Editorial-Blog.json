      "parameters": {
        "jsCode": "const response=$input.first().json;\nconst published=$('Publish approved article atomically').item.json;\nconst expected=published.verificationText;\nif(typeof expected!=='string'||!expected.trim())throw new Error('The editorial API must return a non-empty verificationText for the published article.');\nif(response.statusCode!==200||!String(response.body??response.data).includes(expected))throw new Error('Publication is stored; public rendering requires reconciliation. Do not regenerate this slot.');\nreturn [{json:{status:'published',url:'https://example.com'+published.path,runId:$('Claim budget and original topic').first().json.runId}}];"
      },
