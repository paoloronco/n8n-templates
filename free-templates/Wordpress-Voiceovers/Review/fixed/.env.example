# Google Cloud configuration (required)
# Note: on Cloud Run these are set with `gcloud run deploy --set-env-vars`
# or in the console (Service -> Edit -> Environment variables).
PROJECT_ID=your-gcp-project-id
BUCKET_NAME=wp-voiceovers
TTS_REGION=europe-west12

# Optional shared secret: when set, /long-tts requires the header
#   X-API-Key: <same value>
# Add the same header to the two "HTTP GCP TTS" nodes in n8n.
# API_KEY=change-me
