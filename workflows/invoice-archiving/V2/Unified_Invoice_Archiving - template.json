    {
      "parameters": {
        "jsCode": "const out=[];\nfor (let i=0;i<items.length;i++) {\n const it=items[i]; const from=String(it.json.from?.text||it.json.from||it.json.sender||'').toLowerCase();\n const subject=String(it.json.subject||'').toLowerCase();\n for (const [key,b] of Object.entries(it.binary||{})) {\n  const name=String(b.fileName||b.filename||'');\n  const mime=String(b.mimeType||'').toLowerCase();\n  if (!(name.toLowerCase().endsWith('.pdf')||mime==='application/pdf')) continue;\n  if (b.fileSize && Number(String(b.fileSize).replace(/[^0-9.]/g,''))>20*1024*1024) throw new Error('PDF exceeds 20MB: '+name);\n  out.push({json:{...it.json,attachmentKey:key,originalFileName:name},binary:{data:{...b,fileName:name||'invoice.pdf'}},pairedItem:{item:i}});\n }\n}\nreturn out;"
      },
      "id": "2a81381f-5345-4152-b9e2-9917fbdf897e",
      "name": "Normalize PDF binary",
      "type": "n8n-nodes-base.code",
      "position": [
        912,
        272
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "9ef80dc3-e84a-4fa2-b2c7-c530fb5b9d84",
      "name": "Extract PDF text",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        1264,
        272
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Generic example parser. Customize patterns for your invoice layouts before production use.\nconst source = $('Normalize PDF binary').item;\nif (!source?.json || !source?.binary?.data) throw new Error('Missing source PDF');\nconst text = String(item.json.text || item.json.data || '').replace(/\\\\r/g, '');\nif (text.trim().length < 30) throw new Error('No extractable PDF text; OCR may be required');\nconst patterns = [\n  {provider:'UtilityProvider', category:'utilities', match:/utility provider|electricity|gas bill/i},\n  {provider:'InternetProvider', category:'internet', match:/internet provider|broadband|connectivity/i},\n  {provider:'CloudProvider', category:'cloud', match:/cloud provider|cloud services/i},\n  {provider:'HostingProvider', category:'hosting', match:/hosting provider|hosting services/i},\n];\nconst matches=patterns.filter(p=>p.match.test(text));\nif(matches.length!==1) throw new Error('Unknown or ambiguous provider; configure patterns for your invoices');\nconst {provider,category}=matches[0];\nconst invoiceNumber=(text.match(/(?:Invoice\\\\s*(?:number|no\\\\.?|#)|Fattura\\\\s*(?:n\\\\.?|numero))\\\\s*[:#-]?\\\\s*([A-Z0-9\\\\/-]{4,})/i)||[])[1];\nconst dateMatch=text.match(/(?:Invoice date|Data fattura)\\\\s*[:#-]?\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}|\\\\d{2}[\\\\/.\\\\-]\\\\d{2}[\\\\/.\\\\-]\\\\d{4})/i);\nconst amountMatch=text.match(/(?:Total due|Total amount|Totale da pagare|Importo totale)\\\\s*[:€ ]*([0-9.,]+)/i);\nif(!invoiceNumber||!dateMatch||!amountMatch) throw new Error('Required invoice fields not found; customize extraction rules');\nconst rawDate=dateMatch[1];\nconst date=/^\\\\d{4}-/.test(rawDate)?rawDate:rawDate.split(/[\\\\/.\\\\-]/).reverse().join('-');\nconst raw=amountMatch[1];\nconst normalized=raw.includes(',')&&raw.includes('.')?raw.replace(/\\\\./g,'').replace(',','.'):raw.replace(',','.');\nconst amount=Number(normalized);\nif(!Number.isFinite(amount)||amount<0) throw new Error('Invalid total amount');\nconst safeInvoice=invoiceNumber.replace(/[^A-Za-z0-9_-]/g,'_');\nconst fileName=`${date}_${provider}_${safeInvoice}.pdf`;\nconst targetPath=`/invoices/${category}/${fileName}`;\nreturn {json:{provider,type:category,invoiceNumber,uniqueKey:`${provider}:${invoiceNumber}`,date,amount,account:'',service:'',netAmount:null,vatAmount:null,tab:category,fileName,targetPath,sourceMessageId:source.json.id||source.json.messageId||'',sourceAttachmentKey:source.json.attachmentKey||'',subject:source.json.subject||''},binary:{data:{...source.binary.data,fileName}}};"
      },
