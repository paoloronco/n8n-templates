Internet Invoice","type":"main"}]]},"Upload Utility Invoices SFTP":{"main":[[{"index":0,"node":"Restore Utility Invoice","type":"main"}]]},"Upsert Cloud Invoices in Sheets":{"main":[[{"index":0,"node":"Finish Cloud Invoice Process","type":"main"}]]},"Upsert Hosting Invoices in Sheets":{"main":[[{"index":0,"node":"Finish Hosting Invoice Process","type":"main"}]]},"Upsert Internet Invoices in Sheets":{"main":[[{"index":0,"node":"Finish Internet Invoice Process","type":"main"}]]},"Upsert Utility Invoices in Sheets":{"main":[[{"index":0,"node":"Finish Utility Invoice Process","type":"main"}]]}},"name":"Archive and log invoices from Gmail with SFTP and Google Sheets — V2 — Revised","nodeGroups":[],"nodes":[{"id":"9e625e5b-d30f-4472-9b4e-5664156d0325","name":"Sticky Note","parameters":{"content":"## Archive and log invoice PDFs\n\n### How it works\n1. A manual run or six-hour schedule retrieves matching Gmail messages, including read emails.\n2. Each PDF attachment is separated and its text is extracted.\n3. Configurable rules validate the provider, invoice number, date and total, then build a canonical filename.\n4. Four provider branches upload PDFs over SFTP and upsert the invoice register in Google Sheets. Source emails are retained.\n\n### Setup\n- [ ] Connect Gmail OAuth2 and narrow the email query to your invoice senders.\n- [ ] Customize the rules in **Parse Invoice Details** using text from real invoices.\n- [ ] Create the four `/invoices/` category folders and connect all SFTP nodes.\n- [ ] Share your spreadsheet with the Google service account. Replace the spreadsheet ID in all four Sheets nodes.\n- [ ] Create the `Invoices` tab with Provider, Category, Invoice Number, Date, Amount, File and Unique Key columns.\n- [ ] Test every provider and a multi-PDF email before enabling the schedule.\n\n### Customization\nAdapt provider rules and destination folders. Image-only PDFs require OCR. Repeated runs upload the same filename and upsert the same key; confirm your SFTP overwrite behavior.","height":544,"width":640},"position":[-816,-80],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"b859c818-bf47-4625-b33e-bd10e48a9bbc","name":"Sticky Note1","parameters":{"color":7,"content":"## Start\n\nManual or every six hours.","height":528},"position":[-96,32],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"12e5f632-f63e-48ff-a4b3-c2dcdfdee0a2","name":"Sticky Note2","parameters":{"color":7,"content":"## Read invoice emails\n\nIncludes read mail. Only messages with attachments continue.","height":304,"width":496},"position":[256,144],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"85673683-dd80-40cd-af01-e3db705fad5b","name":"Sticky Note3","parameters":{"color":7,"content":"## Prepare PDF text\n\nKeep PDFs linked to their Gmail message. Scanned PDFs need OCR.","height":304,"width":544},"position":[864,144],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"33647394-7fcd-4054-b292-f85b416c231d","name":"Sticky Note4","parameters":{"color":7,"content":"## Validate\n\nEdit provider rules here.\nMissing fields stop the run.","height":320},"position":[1504,144],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"899a1dd5-df71-4bb7-844c-dc7e6117f9ec","name":"Sticky Note5","parameters":{"color":7,"content":"## Utility invoices\n\nArchive to `/invoices/utilities/`; update Sheets by provider + invoice number.","height":272,"width":1136},"position":[1888,-80],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"c1b3299f-8d96-4101-91cf-9a0a7f858577","name":"Sticky Note6","parameters":{"color":7,"content":"## Internet invoices\n\nArchive to `/invoices/internet/`; update Sheets by provider + invoice number.","height":272,"width":1136},"position":[1888,224],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"d490b44d-2c87-4aa6-8691-6cf7473175b2","name":"Sticky Note7","parameters":{"color":7,"content":"## Cloud invoices\n\nArchive to `/invoices/cloud/`; update Sheets by provider + invoice number.","height":272,"width":1136},"position":[1888,528],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"1985727d-a63a-4808-a84d-2c884c12057e","name":"Sticky Note8","parameters":{"color":7,"content":"## Hosting invoices\n\nArchive to `/invoices/hosting/`; update Sheets by provider + invoice number.","height":272,"width":1136},"position":[1888,832],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"5e6ef999-f2a0-4a79-bfb4-3d195591fc61","name":"Manual Start Trigger","parameters":{},"position":[-48,160],"type":"n8n-nodes-base.manualTrigger","typeVersion":1},{"id":"68c00013-36bb-49d5-bc49-dd21589062b1","name":"Trigger Every 6 Hours","parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":6}]}},"position":[-48,384],"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1},{"id":"baab2d06-9525-412c-add0-e53d9f80052c","name":"Fetch Invoice Emails","parameters":{"filters":{"q":"has:attachment filename:pdf newer_than:30d (subject:invoice OR subject:fattura)","readStatus":"both"},"operation":"getAll","options":{"downloadAttachments":true},"returnAll":true,"simple":false},"position":[304,272],"type":"n8n-nodes-base.gmail","typeVersion":2.1},{"id":"5dd597c7-337a-40d6-83de-1dfd339247d2","name":"Filter Emails with Attachments","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"93c6857c-ec25-4eee-86e1-46c9afedde10","leftValue":"={{ Object.keys($binary ?? {}) }}","operator":{"operation":"lengthGt","rightType":"number","type":"array"},"rightValue":0}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2}},"options":{}},"position":[608,272],"type":"n8n-nodes-base.filter","typeVersion":2.2},{"id":"2a81381f-5345-4152-b9e2-9917fbdf897e","name":"Normalize PDF Attachments","parameters":{"jsCode":"// Split PDF attachments and retain n8n item links and binary storage references.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  for (const [key, binary] of Object.entries(item.binary || {})) {\n    const fileName = String(binary.fileName || binary.filename || 'invoice.pdf');\n    if (!fileName.toLowerCase().endsWith('.pdf') && String(binary.mimeType || '').toLowerCase() !== 'application/pdf') continue;\n    const buffer = await this.helpers.getBinaryDataBuffer(i, key);\n    if (buffer.length > 20 * 1024 * 1024) throw new Error(`PDF exceeds 20 MiB: ${fileName}`);\n    out.push({\n      json: { ...item.json, attachmentKey: key, originalFileName: fileName },\n      binary: { data: { ...binary, fileName } },\n      pairedItem: { item: i },\n    });\n  }\n}\nreturn out;\n"},"position":[912,272],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"9ef80dc3-e84a-4fa2-b2c7-c530fb5b9d84","name":"Extract Text from PDF","parameters":{"operation":"pdf","options":{}},"position":[1264,272],"type":"n8n-nodes-base.extractFromFile","typeVersion":1},{"id":"3888ca64-d271-450b-ba9e-53a576b2309e","name":"Parse Invoice Details","parameters":{"jsCode":"// Replace these example provider rules with patterns from your text-based PDFs.\nconst source = $('Normalize PDF Attachments').item;\nif (!source?.json || !source?.binary?.data) throw new Error('Missing source PDF');\nconst sourceMessageId = source.json.id || source.json.messageId;\nif (!sourceMessageId) throw new Error('Missing source Gmail message ID');\nconst text = String($input.item.json.text || $input.item.json.data || '').replace(/\\r/g, '');\nif (text.trim().length < 30) throw new Error('No extractable PDF text; OCR may be required');\nconst patterns = [\n  { provider: 'UtilityProvider', category: 'utilities', match: /utility provider|electricity|gas bill/i },\n  { provider: 'InternetProvider', category: 'internet', match: /internet provider|broadband|connectivity/i },\n  { provider: 'CloudProvider', category: 'cloud', match: /cloud provider|cloud services/i },\n  { provider: 'HostingProvider', category: 'hosting', match: /hosting provider|hosting services/i },\n];\nconst matches = patterns.filter(p => p.match.test(text));\nif (matches.length !== 1) throw new Error('Unknown or ambiguous provider; configure patterns for your invoices');\nconst { provider, category } = matches[0];\nconst invoiceNumber = (text.match(/(?:Invoice\\s*(?:number|no\\.?|#)|Fattura\\s*(?:n\\.?|numero))\\s*[:#-]?\\s*([A-Z0-9][A-Z0-9\\/_-]*)/i) || [])[1];\nconst dateMatch = text.match(/(?:Invoice date|Data fattura)\\s*[:#-]?\\s*(\\d{4}-\\d{2}-\\d{2}|\\d{2}[/.\\-]\\d{2}[/.\\-]\\d{4})(?!\\d)/i);\nconst amountMatch = text.match(/(?:Total due|Total amount|Totale da pagare|Importo totale)\\s*[:]?\\s*(?:(?:EUR|USD|GBP|[€$£])\\s*)?(-?[0-9][0-9.,]*)/i);\nif (!invoiceNumber || !dateMatch || !amountMatch) throw new Error('Required invoice fields not found; customize extraction rules');\nconst rawDate = dateMatch[1];\nconst date = /^\\d{4}-/.test(rawDate) ? rawDate : rawDate.split(/[/.\\-]/).reverse().join('-');\nconst parsedDate = new Date(`${date}T00:00:00.000Z`);\nif (!Number.isFinite(parsedDate.getTime()) || parsedDate.toISOString().slice(0, 10) !== date) throw new Error('Invalid invoice date');\nconst rawAmount = amountMatch[1];\nlet normalized;\nif (rawAmount.includes(',') && rawAmount.includes('.')) {\n  const decimal = rawAmount.lastIndexOf(',') > rawAmount.lastIndexOf('.') ? ',' : '.';\n  const grouping = decimal === ',' ? '.' : ',';\n  const escapedGrouping = grouping === '.' ? '\\\\.' : ',';\n  const escapedDecimal = decimal === '.' ? '\\\\.' : ',';\n  if (!new RegExp(`^-?\\\\d{1,3}(?:${escapedGrouping}\\\\d{3})+${escapedDecimal}\\\\d{1,2}$`).test(rawAmount)) throw new Error('Invalid total amount');\n  normalized = rawAmount.split(grouping).join('').replace(decimal, '.');\n} else {\n  // A lone separator is decimal; more than two fractional digits is ambiguous.\n  if (!/^-?\\d+(?:[.,]\\d{1,2})?$/.test(rawAmount)) throw new Error('Invalid or ambiguous total amount');\n  normalized = rawAmount.replace(',', '.');\n}\nconst amount = Number(normalized);\nif (!Number.isFinite(amount) || amount < 0) throw new Error('Invalid total amount');\nconst safeInvoice = encodeURIComponent(invoiceNumber);\nconst fileName = `${date}_${provider}_${safeInvoice}.pdf`;\nconst targetPath = `/invoices/${category}/${fileName}`;\nreturn {\n  json: { provider, type: category, invoiceNumber, uniqueKey: `${provider}:${invoiceNumber}`, date, amount,\n    account: '', service: '', netAmount: null, vatAmount: null, tab: category, fileName, targetPath,\n    sourceMessageId, sourceAttachmentKey: source.json.attachmentKey || '', subject: source.json.subject || '' },\n  binary: { data: { ...source.binary.data, fileName } },\n};\n","mode":"runOnceForEachItem"},"position":[1568,272],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"763de55a-2d51-42f6-9cd5-b4761a459437","name":"Filter Utility Invoices","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"60c4293a-55e6-4837-bd05-db61f50af88e","leftValue":"={{ $json.provider }}","operator":{"operation":"equals","type":"string"},"rightValue":"UtilityProvider"}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2}},"options":{}},"position":[1936,32],"type":"n8n-nodes-base.filter","typeVersion":2.2},{"id":"b43ae77c-c939-4fde-a417-118157e93d01","maxTries":3,"name":"Upload Utility Invoices SFTP","parameters":{"operation":"upload","options":{},"path":"={{ $json.targetPath }}","protocol":"sftp"},"position":[2192,32],"retryOnFail":true,"type":"n8n-nodes-base.ftp","typeVersion":1,"waitBetweenTries":3000},{"id":"9d46e73a-264c-465f-bd68-519b0a87402d","maxTries":3,"name":"Upsert Utility Invoices in Sheets","parameters":{"authentication":"serviceAccount","columns":{"mappingMode":"defineBelow","matchingColumns":["Unique Key"],"schema":[{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Provider","id":"Provider","required":false,"type":"string"},{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Category","id":"Category","required":false