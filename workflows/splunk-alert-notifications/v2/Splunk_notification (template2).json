    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response=$json??{};\nconst d=response.data??{};\nconst state=$getWorkflowStaticData('global');\nconst cache=state._splunkEnrichment||{};\n\n// AbuseIPDB returns the checked IP as data.ipAddress.\nconst key=String(d.ipAddress||'__no_ip__');\nconst base=cache[key]||{};\nif (cache[key]) delete cache[key];\n\nreturn {json:{\n  ...base,\n  threat_intel:{\n    abuse_confidence_score:Number(d.abuseConfidenceScore||0),\n    country_code:d.countryCode||'N/A',\n    isp:d.isp||'N/A',\n    total_reports:Number(d.totalReports||0)\n  }\n}};"
