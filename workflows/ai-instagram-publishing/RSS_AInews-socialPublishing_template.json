      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "// Code node — Run Once for All Items\n\n// Collect all links from input items\nconst links = [];\nfor (const item of $input.all()) {\n  if (item.json.link) {\n    links.push(item.json.link);\n  }\n  // if articles are inside \"chosen\" array:\n  if (Array.isArray(item.json.chosen)) {\n    for (const c of item.json.chosen) {\n      if (c.link) links.push(c.link);\n    }\n  }\n}\n\n// Return as one item with all links\nreturn [\n  {\n    json: {\n      links,                          // array of links\n      linksString: links.join(\"\\n\")   // optional: single string\n    }\n  }\n];"
      },
