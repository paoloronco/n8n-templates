        "jsCode": "const i=$json;let s=({critical:50,high:35,medium:20,low:5,informational:0})[i.splunk_severity]??0,a=+i.failed_attempts||0;s+=a>=50?25:a>=20?15:a>=10?10:a>=3?5:0;const ab=+i.threat_intel.abuse_confidence_score||0;s+=ab>=90?30:ab>=70?20:ab>=40?10:0;const u=+i.unique_users||0,h=+i.unique_hosts||0;s+=u>=10?15:u>=5?10:0;s+=h>=5?15:h>=2?5:0;s=Math.min(100,s);const l=s>=75?'critical':s>=50?'high':s>=30?'medium':'low',m={critical:['CRITICAL','🔴','#b91c1c'],high:['HIGH','🟠','#c2410c'],medium:['MEDIUM','🟡','#a16207'],low:['LOW','🟢','#4d7c0f']}[l];return{json:{...i,risk_score:s,risk_level:l,risk_label:m[0],risk_emoji:m[1],risk_color:m[2]}};"
