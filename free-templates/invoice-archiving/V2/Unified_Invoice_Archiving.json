      "parameters": {
        "jsCode": "// EDIT THE FOUR EXAMPLE PROFILES. Patterns are JavaScript regular expression source strings.\nconst providers = [\n  {\n    \"id\": \"PROVIDER_A\",\n    \"name\": \"Provider A\",\n    \"senderContains\": \"billing@provider-a.example\",\n    \"invoicePattern\": \"(?:Invoice\\\\s*(?:Number|No\\\\.?|#)|Fattura\\\\s*n\\\\.?)\\\\s*[:#-]?\\\\s*([A-Z0-9/-]+)\",\n    \"datePattern\": \"(?:Invoice\\\\s*Date|Date|Data\\\\s*fattura)\\\\s*[:#-]?\\\\s*(\\\\d{1,2}[./-]\\\\d{1,2}[./-]20\\\\d{2})\",\n    \"amountPattern\": \"(?:Grand\\\\s*Total|Total\\\\s*Due|Totale\\\\s*da\\\\s*pagare)\\\\s*[:€ ]*([0-9.,]+)\",\n    \"servicePattern\": \"(?:Service|Servizio)\\\\s*[:#-]?\\\\s*([^\\\\n]+)\",\n    \"currency\": \"EUR\",\n    \"folder\": \"/YOUR_SFTP_ROOT/provider-a\"\n  },\n  {\n    \"id\": \"PROVIDER_B\",\n    \"name\": \"Provider B\",\n    \"senderContains\": \"billing@provider-b.example\",\n    \"invoicePattern\": \"(?:Invoice\\\\s*(?:Number|No\\\\.?|#)|Fattura\\\\s*n\\\\.?)\\\\s*[:#-]?\\\\s*([A-Z0-9/-]+)\",\n    \"datePattern\": \"(?:Invoice\\\\s*Date|Date|Data\\\\s*fattura)\\\\s*[:#-]?\\\\s*(\\\\d{1,2}[./-]\\\\d{1,2}[./-]20\\\\d{2})\",\n    \"amountPattern\": \"(?:Grand\\\\s*Total|Total\\\\s*Due|Totale\\\\s*da\\\\s*pagare)\\\\s*[:€ ]*([0-9.,]+)\",\n    \"servicePattern\": \"(?:Service|Servizio)\\\\s*[:#-]?\\\\s*([^\\\\n]+)\",\n    \"currency\": \"EUR\",\n    \"folder\": \"/YOUR_SFTP_ROOT/provider-b\"\n  },\n  {\n    \"id\": \"PROVIDER_C\",\n    \"name\": \"Provider C\",\n    \"senderContains\": \"billing@provider-c.example\",\n    \"invoicePattern\": \"(?:Invoice\\\\s*(?:Number|No\\\\.?|#)|Fattura\\\\s*n\\\\.?)\\\\s*[:#-]?\\\\s*([A-Z0-9/-]+)\",\n    \"datePattern\": \"(?:Invoice\\\\s*Date|Date|Data\\\\s*fattura)\\\\s*[:#-]?\\\\s*(\\\\d{1,2}[./-]\\\\d{1,2}[./-]20\\\\d{2})\",\n    \"amountPattern\": \"(?:Grand\\\\s*Total|Total\\\\s*Due|Totale\\\\s*da\\\\s*pagare)\\\\s*[:€ ]*([0-9.,]+)\",\n    \"servicePattern\": \"(?:Service|Servizio)\\\\s*[:#-]?\\\\s*([^\\\\n]+)\",\n    \"currency\": \"EUR\",\n    \"folder\": \"/YOUR_SFTP_ROOT/provider-c\"\n  },\n  {\n    \"id\": \"PROVIDER_D\",\n    \"name\": \"Provider D\",\n    \"senderContains\": \"billing@provider-d.example\",\n    \"invoicePattern\": \"(?:Invoice\\\\s*(?:Number|No\\\\.?|#)|Fattura\\\\s*n\\\\.?)\\\\s*[:#-]?\\\\s*([A-Z0-9/-]+)\",\n    \"datePattern\": \"(?:Invoice\\\\s*Date|Date|Data\\\\s*fattura)\\\\s*[:#-]?\\\\s*(\\\\d{1,2}[./-]\\\\d{1,2}[./-]20\\\\d{2})\",\n    \"amountPattern\": \"(?:Grand\\\\s*Total|Total\\\\s*Due|Totale\\\\s*da\\\\s*pagare)\\\\s*[:€ ]*([0-9.,]+)\",\n    \"servicePattern\": \"(?:Service|Servizio)\\\\s*[:#-]?\\\\s*([^\\\\n]+)\",\n    \"currency\": \"EUR\",\n    \"folder\": \"/YOUR_SFTP_ROOT/provider-d\"\n  }\n];\nreturn items.map(it=>({json:{...it.json,providerProfiles:providers},binary:it.binary,pairedItem:it.pairedItem}));"
