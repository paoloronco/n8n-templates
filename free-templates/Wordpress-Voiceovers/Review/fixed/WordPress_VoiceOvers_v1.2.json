        "mode": "runOnceForEachItem",
        "jsCode": "function decodeHTMLEntities(text) {\n  const entities = {\n    '&amp;': '&',\n    '&lt;': '<',\n    '&gt;': '>',\n    '&quot;': '\"',\n    '&#39;': \"'\",\n  };\n  return text.replace(/&[a-zA-Z#0-9]+;/g, (match) => entities[match] || match);\n}\n\nlet rawHtml = $json[\"content\"][\"rendered\"];\n\nlet cleanText = rawHtml\n  .replace(/<br\\s*\\/?>/gi, \". \")\n  .replace(/<\\/p>/gi, \". \")\n  .replace(/<li>/gi, \"\")\n  .replace(/<\\/li>/gi, \". \")\n  .replace(/<\\/?[^>]+(>|$)/g, \"\")\n  .replace(/([a-z])\\.([A-Z])/g, \"$1. $2\")\n  .replace(/\\n+/g, \" \")\n  .replace(/[ \\t]{2,}/g, \" \")\n  .trim();\n\n// Decodifica entità HTML\ncleanText = decodeHTMLEntities(cleanText);\n\n// Rimuove caratteri speciali pericolosi\ncleanText = cleanText\n  .replace(/[\"\\\\$=/]/g, \"\")    // Rimuove \", \\, $, =, /\n  .replace(/\\s{2,}/g, \" \")     // Pulisce eventuali spazi doppi di nuovo\n  .trim();\n\nreturn {\n  text: cleanText\n};"
      },
