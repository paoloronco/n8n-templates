      "id": "6a81d137-51fe-4875-b4ca-47210d2d0eff",
      "name": "Keep messages with attachments",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        2304,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const out=[];\nfor (let i=0;i<items.length;i++) {\n const it=items[i]; const from=String(it.json.from?.text||it.json.from||it.json.sender||'').toLowerCase();\n const subject=String(it.json.subject||'').toLowerCase();\n for (const [key,b] of Object.entries(it.binary||{})) {\n  const name=String(b.fileName||b.filename||'');\n  const mime=String(b.mimeType||'').toLowerCase();\n  if (!(name.toLowerCase().endsWith('.pdf')||mime==='application/pdf')) continue;\n  if ((from.includes('octopus')||subject.includes('octopus')) && !(/fattura|bolletta/i.test(name+' '+subject))) continue;\n  if (b.fileSize && Number(String(b.fileSize).replace(/[^0-9.]/g,''))>20*1024*1024) throw new Error('PDF exceeds 20MB: '+name);\n  out.push({json:{...it.json,attachmentKey:key,originalFileName:name},binary:{data:{...b,fileName:name||'invoice.pdf'}},pairedItem:{item:i}});\n }\n}\nreturn out;"
      },
      "id": "f75593c0-aead-4d45-85a7-5a6a585a7bc0",
      "name": "Normalize PDF binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        192
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "9387c62c-f4e4-4729-a722-ebf81f325e19",
      "name": "Extract PDF text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        2960,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Normalize PDF binary').item;\nif (!source?.json) throw new Error('Missing paired source PDF');\nconst bin = source.binary || {};\nconst b = bin.data || {};\nconst text = String(item.json.text || item.json.data || item.json.output || item.json.content || item.json.document || '').replace(/\\r/g,'');\nif (text.trim().length < 30) throw new Error('Empty or image-only PDF: OCR needed');\nconst subject = String(source.json.subject || '');\nconst from = String(source.json.from?.text || source.json.from || source.json.sender || '').toLowerCase();\nfunction normDate(y,m,d){return `${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`}\nfunction ymd(s){return String(s||'').replace(/-/g,'')}\nfunction money(v){ if(v==null) return null; let s=String(v).replace(/\\s|€/g,''); if(s.includes(',')&&s.includes('.')) s=s.replace(/\\./g,'').replace(',','.'); else s=s.replace(',','.'); const n=Number(s.replace(/[^0-9.-]/g,'')); return Number.isFinite(n)?Math.round(n*100)/100:null; }\nfunction m1(pat){ const m=text.match(pat); return m?m[1]:null; }\nfunction dateFromText(){\n for (const pat of [/(?:Data fattura|DATA FATTURA|Data del documento|Documento del|Invoice date|Data)\\D{0,35}(\\d{1,2})[/-](\\d{1,2})[/-](20\\d{2})/i,/(\\d{1,2})[/-](\\d{1,2})[/-](20\\d{2})/]) { const m=text.match(pat); if(m) return normDate(m[3],m[2],m[1]); }\n for (const pat of [/(?:Invoice date|Date of invoice|Rechnungsdatum)\\D{0,35}(\\d{1,2})[./-](\\d{1,2})[./-](20\\d{2})/i, /(?:Invoice date|Date of invoice|Rechnungsdatum)\\D{0,35}(20\\d{2})[-/.](\\d{1,2})[-/.](\\d{1,2})/i]) { const m=text.match(pat); if(m) return m[1].length===4?normDate(m[1],m[2],m[3]):normDate(m[3],m[2],m[1]); }\n return '';\n}\nlet provider='', type='', invoice='', date='', amount=null, account='', tab='', folder='';\nif (from.includes('octopus') || /Octopus/i.test(text+subject)) {\n provider='OctopusEnergy';\n const head=(text.slice(0,5000)+' '+subject);\n const luce=/bolletta\\s+luce/i.test(head) || /fornitura:\\s*energia\\s+elettrica/i.test(head) || /\\bkWh\\b/i.test(head);\n const gas=/bolletta\\s+gas/i.test(head) || /fornitura:\\s*gas/i.test(head) || /\\bSmc\\b/i.test(head);\n if (luce && !gas) type='luce'; else if (gas && !luce) type='gas'; else throw new Error(`Octopus type ambiguous: luce=${luce} gas=${gas} file=${b.fileName||''} subject=${subject}`);\n invoice=m1(/(A-\\d{4}A\\d+-\\d+)/i) || (b.fileName||'').match(/(A-\\d{4}A\\d+-\\d+)/i)?.[1] || m1(/(?:NUMERO FATTURA ELETTRONICA VALIDA AI FINI FISCALI|Fattura n:)\\s*([A-Z0-9-]+)/i) || '';\n date=dateFromText();\n amount=money(m1(/Questo mese dovrai pagare\\s*\\n\\s*([0-9]+[,.][0-9]{2})\\s*€/i) || m1(/Totale:\\s*([0-9]+[,.][0-9]{2})\\s*€/i) || m1(/Totale importo da pagare\\s*\\n\\s*€?\\s*([0-9]+[,.][0-9]{2})/i) || m1(/Totale \\(IVA inclusa\\)\\s*:?\\s*([0-9]+[,.][0-9]{2})/i) || m1(/TOTALE DA PAGARE\\s*([0-9]+[,.][0-9]{2})/i));\n tab='Fatture-luce'; folder=`/YOUR_SFTP_ROOT/CASA/UTENZE-LuceGas/OctopusEnergy/${type}`;\n} else if (from.includes('dimensione') || /Dimensione/i.test(text+subject)) {\n provider='Dimensione'; type='internet'; invoice=(text.match(/(\\d{5,})\\s*\\/\\s*([A-Z])\\s*\\/\\s*(20\\d{2})/)||[]).slice(1).join('-') || '';\n date=dateFromText(); amount=money(m1(/TOTALE\\s+FATTURA\\s*([0-9]+[,.][0-9]{2})/i)); tab='Fatture-ISP'; folder='/YOUR_SFTP_ROOT/CASA/ISP/Dimensione/Fatture';\n} else if (from.includes('hetzner.com') || /Hetzner\\s+(?:Online|Cloud)|Hetzner Online GmbH/i.test(text+subject)) {\n provider='Hetzner'; type='cloud';\n invoice=m1(/(?:Invoice\\s*(?:number|no\\.?|#)|Rechnungs(?:nummer|nr\\.? )|Invoice\\s*No\\.?|Fattura\\s*n\\.?)[\\s:#-]*([A-Z0-9][A-Z0-9\\/-]{3,})/i) || String(b.fileName||'').match(/(?:invoice|rechnung)[-_\\s]*([0-9]{5,})/i)?.[1] || '';\n date=dateFromText();\n // Hetzner overview: Service | Period | Total (excl. VAT) | Tax | Total.\n // Read the final total on the overview row, not the net amount.\n // PDF extraction may put each table cell on a separate line.\n // Restrict extraction to Overview, before payment instructions / product details.\n const overview=text.match(/\\bOverview\\b([\\s\\S]*?)(?:Please pay|Click here|Due upon receipt|\\bProduct\\s+count\\b)/i)?.[1] || '';\n const overviewLines=overview.split('\\n').map(x=>x.trim()).filter(Boolean);\n let gross=null, net=null, vat=null, service='';\n const amounts=[...overview.matchAll(/€\\s*([\\d.,]+[.,]\\d{2})(?!\\d)/g)].map(m=>money(m[1]));\n // In the Hetzner Overview each service row ends in net, tax, gross.\n // The last three monetary values in the overview are the final totals.\n if(amounts.length>=3 && amounts.length%3===0) {\n   net=amounts[amounts.length-3];\n   vat=amounts[amounts.length-2];\n   gross=amounts[amounts.length-1];\n }\n // Require arithmetic consistency; never silently fall back to net.\n if(gross===null || net===null || vat===null || Math.abs((net+vat)-gross)>0.02)\n   throw new Error(`Hetzner Overview totals invalid: monetary values=${JSON.stringify(amounts)}`);\n amount=gross;\n const productMatch=text.match(/\\b(BX\\d+\\s+Storage Box|(?:CX|CPX|CCX|AX|EX|PX)\\d+[A-Z0-9-]*\\s+[^\\n€]{0,65}|Storage Box|Cloud Server)\\b/i);\n service=productMatch?.[1]?.trim() || overviewLines.find(l=>/^(?:Storage|Cloud|Server|Domain|Web Hosting|Managed|Networking)\\s+\\d{2}\\/20\\d{2}/i.test(l))?.split(/\\s+\\d{2}\\/20\\d{2}/)[0] || '';\n account=m1(/(?:Customer\\s*(?:number|ID)|Kundennummer|Client\\s*ID)[\\s:#-]*([A-Z0-9-]+)/i)||'';\n item.json.service=service;\n item.json.netAmount=net;\n item.json.vatAmount=vat;\n tab='Hetzner'; folder='/YOUR_SFTP_ROOT/ACQUISTI/Hetzner';\n} else if (from.includes('google') || /Google Cloud/i.test(text+subject)) {\n provider='GoogleCloud'; type='cloud'; invoice=m1(/(GCITD\\d+)/i) || ''; date=dateFromText(); account=m1(/ID account\\s*([0-9A-Z-]+)/i)||'';\n amount=money(m1(/([0-9]+[,.][0-9]{2})\\s*€?\\s*Totale in EUR/i) || m1(/Totale in EUR\\s*([0-9]+[,.][0-9]{2})/i) || m1(/Importo totale\\s*([0-9]+[,.][0-9]{2})/i)); tab='GoogleCloud'; folder='/YOUR_SFTP_ROOT/ACQUISTI/GoogleCloud';\n}\nif(!provider || !type || !invoice || !date || amount===null) throw new Error(`Cannot parse invoice: provider=${provider} type=${type} invoice=${invoice} date=${date} amount=${amount} file=${b.fileName||''} subject=${subject}`);\nconst fileName = `${ymd(date)} ${type} ${provider} ${invoice}.pdf`;\nreturn {json:{provider,type,invoiceNumber:invoice,uniqueKey:`${provider}:${invoice}`, date,amount,account,service:item.json.service||'',netAmount:item.json.netAmount??null,vatAmount:item.json.vatAmount??null,tab,fileName,targetPath:`${folder}/${fileName}`,sourceMessageId:source.json.id||source.json.messageId||'',sourceAttachmentKey:source.json.attachmentKey||'',subject}, binary:{data:{...b,fileName}}};"
      },
