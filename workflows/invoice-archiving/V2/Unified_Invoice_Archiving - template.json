      "id": "baab2d06-9525-412c-add0-e53d9f80052c",
      "name": "Fetch Invoice Emails",
      "type": "n8n-nodes-base.gmail",
      "position": [
        304,
        272
      ],
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "93c6857c-ec25-4eee-86e1-46c9afedde10",
              "operator": {
                "type": "array",
                "operation": "lengthGt",
                "rightType": "number"
              },
              "leftValue": "={{ Object.keys($binary ?? {}) }}",
              "rightValue": 0
            }
          ]
        },
        "options": {}
      },
      "id": "5dd597c7-337a-40d6-83de-1dfd339247d2",
      "name": "Filter Emails with Attachments",
      "type": "n8n-nodes-base.filter",
      "position": [
        608,
        272
      ],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "jsCode": "// Split PDF attachments and retain n8n item links and binary storage references.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  for (const [key, binary] of Object.entries(item.binary || {})) {\n    const fileName = String(binary.fileName || binary.filename || 'invoice.pdf');\n    if (!fileName.toLowerCase().endsWith('.pdf') && String(binary.mimeType || '').toLowerCase() !== 'application/pdf') continue;\n    const buffer = await this.helpers.getBinaryDataBuffer(i, key);\n    if (buffer.length > 20 * 1024 * 1024) throw new Error(`PDF exceeds 20 MiB: ${fileName}`);\n    out.push({\n      json: { ...item.json, attachmentKey: key, originalFileName: fileName },\n      binary: { data: { ...binary, fileName } },\n      pairedItem: { item: i },\n    });\n  }\n}\nreturn out;\n"
      },
      "id": "2a81381f-5345-4152-b9e2-9917fbdf897e",
      "name": "Normalize PDF Attachments",
      "type": "n8n-nodes-base.code",
      "position": [
        912,
        272
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "9ef80dc3-e84a-4fa2-b2c7-c530fb5b9d84",
      "name": "Extract Text from PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        1264,
        272
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Replace these example provider rules with patterns from your text-based PDFs.\nconst source = $('Normalize PDF Attachments').item;\nif (!source?.json || !source?.binary?.data) throw new Error('Missing source PDF');\nconst sourceMessageId = source.json.id || source.json.messageId;\nif (!sourceMessageId) throw new Error('Missing source Gmail message ID');\nconst text = String($input.item.json.text || $input.item.json.data || '').replace(/\\r/g, '');\nif (text.trim().length < 30) throw new Error('No extractable PDF text; OCR may be required');\nconst patterns = [\n  { provider: 'UtilityProvider', category: 'utilities', match: /utility provider|electricity|gas bill/i },\n  { provider: 'InternetProvider', category: 'internet', match: /internet provider|broadband|connectivity/i },\n  { provider: 'CloudProvider', category: 'cloud', match: /cloud provider|cloud services/i },\n  { provider: 'HostingProvider', category: 'hosting', match: /hosting provider|hosting services/i },\n];\nconst matches = patterns.filter(p => p.match.test(text));\nif (matches.length !== 1) throw new Error('Unknown or ambiguous provider; configure patterns for your invoices');\nconst { provider, category } = matches[0];\nconst invoiceNumber = (text.match(/(?:Invoice\\s*(?:number|no\\.?|#)|Fattura\\s*(?:n\\.?|numero))\\s*[:#-]?\\s*([A-Z0-9][A-Z0-9\\/_-]*)/i) || [])[1];\nconst dateMatch = text.match(/(?:Invoice date|Data fattura)\\s*[:#-]?\\s*(\\d{4}-\\d{2}-\\d{2}|\\d{2}[/.\\-]\\d{2}[/.\\-]\\d{4})(?!\\d)/i);\nconst amountMatch = text.match(/(?:Total due|Total amount|Totale da pagare|Importo totale)\\s*[:]?\\s*(?:(?:EUR|USD|GBP|[€$£])\\s*)?(-?[0-9][0-9.,]*)/i);\nif (!invoiceNumber || !dateMatch || !amountMatch) throw new Error('Required invoice fields not found; customize extraction rules');\nconst rawDate = dateMatch[1];\nconst date = /^\\d{4}-/.test(rawDate) ? rawDate : rawDate.split(/[/.\\-]/).reverse().join('-');\nconst parsedDate = new Date(`${date}T00:00:00.000Z`);\nif (!Number.isFinite(parsedDate.getTime()) || parsedDate.toISOString().slice(0, 10) !== date) throw new Error('Invalid invoice date');\nconst rawAmount = amountMatch[1];\nlet normalized;\nif (rawAmount.includes(',') && rawAmount.includes('.')) {\n  const decimal = rawAmount.lastIndexOf(',') > rawAmount.lastIndexOf('.') ? ',' : '.';\n  const grouping = decimal === ',' ? '.' : ',';\n  const escapedGrouping = grouping === '.' ? '\\\\.' : ',';\n  const escapedDecimal = decimal === '.' ? '\\\\.' : ',';\n  if (!new RegExp(`^-?\\\\d{1,3}(?:${escapedGrouping}\\\\d{3})+${escapedDecimal}\\\\d{1,2}$`).test(rawAmount)) throw new Error('Invalid total amount');\n  normalized = rawAmount.split(grouping).join('').replace(decimal, '.');\n} else {\n  // A lone separator is decimal; more than two fractional digits is ambiguous.\n  if (!/^-?\\d+(?:[.,]\\d{1,2})?$/.test(rawAmount)) throw new Error('Invalid or ambiguous total amount');\n  normalized = rawAmount.replace(',', '.');\n}\nconst amount = Number(normalized);\nif (!Number.isFinite(amount) || amount < 0) throw new Error('Invalid total amount');\nconst safeInvoice = encodeURIComponent(invoiceNumber);\nconst fileName = `${date}_${provider}_${safeInvoice}.pdf`;\nconst targetPath = `/invoices/${category}/${fileName}`;\nreturn {\n  json: { provider, type: category, invoiceNumber, uniqueKey: `${provider}:${invoiceNumber}`, date, amount,\n    account: '', service: '', netAmount: null, vatAmount: null, tab: category, fileName, targetPath,\n    sourceMessageId, sourceAttachmentKey: source.json.attachmentKey || '', subject: source.json.subject || '' },\n  binary: { data: { ...source.binary.data, fileName } },\n};\n"
      },
